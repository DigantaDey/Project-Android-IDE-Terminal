{
  "name": "forge-ide-source-formatting",
  "private": true,
  "version": "1.0.0",
  "devDependencies": {
    "prettier": "3.6.2",
    "prettier-plugin-java": "2.7.6"
  },
  "scripts": {
    "format": "prettier --plugin=prettier-plugin-java --write '../../app/src/**/*.java' '../../core/*/src/**/*.java'",
    "check": "prettier --plugin=prettier-plugin-java --check '../../app/src/**/*.java' '../../core/*/src/**/*.java'"
  }
}
